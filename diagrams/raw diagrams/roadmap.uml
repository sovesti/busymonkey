
@startuml
title Anti Time Tracker — Roadmap разработки

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #64748B

skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #1E293B
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #94A3B8
  StartColor #16A34A
  EndColor #DC2626
}

start

partition "1. Аналитика и проектирование" #D9EAD3 {
  :Сравнить 7 систем мониторинга;
  :Составить матрицу функций конкурентов;
  :Зафиксировать ФТ и НФТ;
  :Выбрать ОС, язык и UI-фреймворк;
  :Спроектировать модули приложения;
  :Результат: требования + архитектура;
}

partition "2. Базовое приложение" #D9EAF7 {
  :Создать главное окно;
  :Добавить переключатель активности;
  :Добавить настройки интервалов;
  :Добавить настройки движения мыши;
  :Добавить настройки клавиатуры;
  :Реализовать горячие клавиши;
  :Сохранять настройки локально;
  :Результат: рабочий прототип;
}

partition "3. Движок шаблонов" #D9D2E9 {
  :Создать формат шаблона;
  :Добавить список шаблонов;
  :Реализовать запись разрешённых действий;
  :Добавить запуск и остановку сценария;
  :Добавить паузу и обработку ошибок;
  :Реализовать импорт и экспорт шаблонов;
  :Результат: пользовательские сценарии;
}

partition "4. Автоматическое управление" #FFF2CC {
  :Определять физический ввод пользователя;
  :Приостанавливать сценарий при вводе;
  :Возобновлять сценарий по настройке;
  :Добавить горячую остановку;
  :Проверить конфликты с реальной работой;
  :Результат: управляемая сессия;
}

partition "5. Браузер и платформы" #FCE4D6 {
  :Выбрать механизм браузерной интеграции;
  :Реализовать разрешённые действия в браузере;
  :Проверить совместимость с целевыми браузерами;
  :Реализовать экспорт настроек на другое устройство;
  :Проверить сборку на каждой целевой ОС;
  :Результат: переносимость и интеграции;
}

partition "6. Приватность и качество" #CFE2F3 {
  :Проверить сетевые обращения приложения;
  :Исключить передачу данных без согласия;
  :Проверить данные в логах и конфигурациях;
  :Проверить отображение процесса в ОС;
  :Измерить CPU и RAM;
  :Провести функциональные тесты;
  :Исправить критические дефекты;
  :Результат: кандидат на релиз;
}

stop
@enduml