@startuml
title BusyMonkey — Roadmap

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #64748B
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 25

skinparam component {
  BorderColor #CBD5E1
  FontColor #1E293B
}

component S1 #889cbd [
  **sprint 1**
  *Сравнить 7 систем мониторинга;
  *Составить матрицу функций конкурентов;
  *Зафиксировать ФТ и НФТ;
  *Выбрать стек;
  *Спроектировать модули приложения;
]

component S2 #44c9b6 [
  **sprint 2**
  *Добавить интервалы и таймер;
  *Добавить настройки движения мыши;
  *Сохранять настройки локально;
  *Обеспечить автономный запуск без входа;
]

component S3 #cc8eed [
  **sprint 3**
  *Создать окно и отображение состояния;
  *Добавить запуск и остановку сценария;
  *Добавить шаблоны и профили;
  *Реализовать запись разрешённых действий;
  *Реализовать импорт и экспорт шаблонов;
  *Анализ bitcop
]

component S4 #d7ed8e [
  **sprint 4**
  *Реализовать импорт и экспорт шаблонов;
  *Определять физический ввод пользователя;
  *Приостанавливать сценарий при вводе;
  *Возобновлять сценарий по настройке;
]

component S5 #f0cd65 [
  **sprint 5**
  *Импорт и экспорт настроек с браузером
  *Сокрытие процессов и портов
]

component S6 #2ed96c [
  **sprint 6**
  *Проверить сетевые обращения приложения;
  *Исключить передачу данных без согласия;
  *Проверить данные в логах и конфигурациях;
  *Проверить отображение процесса в ОС;
  *Измерить CPU и RAM;
  *Провести функциональные тесты;
  *Исправить критические дефекты;
]

S1 -r-> S2
S2 -r-> S3
S3 -d-> S4
S4 -l-> S5
S5 -l-> S6

S1 -[hidden]d-> S6
S2 -[hidden]d-> S5

scale max 1400*750


@enduml
